# 本地配置保存为 .env.local，实际 Key 从阿里云控制台填写。
# 北京兼容地址。其他地域需使用对应地域和工作空间的完整地址。
MODEL_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
MODEL_NAME=qwen3.8-omni-flash
MODEL_API_KEY=
# 中文实时识别。默认复用 MODEL_API_KEY；如需独立密钥，填写 ASR_API_KEY。
ASR_MODEL=qwen-audio-3.1-asr-flash-message
ASR_API_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference/
# ASR_API_KEY=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:5176
