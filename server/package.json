{
  "name": "3dcar-intent-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": "^22.12.0 || >=24.0.0" },
  "scripts": {
    "dev": "wrangler dev --ip 127.0.0.1 --port 8787",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test .test-build/server/test/intent.test.js .test-build/server/test/quota.test.js .test-build/server/test/speech.test.js",
    "test:speech-live": "node test/speech-live.mjs",
    "build": "wrangler deploy --dry-run --outdir .worker-build",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "~5.9.3",
    "ws": "8.21.0",
    "wrangler": "4.157.0"
  }
}
